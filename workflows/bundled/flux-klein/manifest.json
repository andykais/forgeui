{
  "id": "flux-klein",
  "name": "Flux.2 Klein 4B",
  "family": "flux2",
  "kind": "image",
  "category": null,
  "description": "Text-to-image with the distilled FLUX.2 [klein] 4B: four steps at cfg 1 through the custom sampler chain. Qwen-3 4B encodes the prompt; the negative is ConditioningZeroOut, as the template ships it.",
  "params": [
    {
      "key": "prompt",
      "label": "Prompt",
      "type": "text",
      "required": true,
      "default": "",
      "bind": "13.text"
    },
    {
      "key": "model",
      "label": "Model",
      "type": "model",
      "filter": {
        "class": "diffusion",
        "family": "flux2"
      },
      "default": "flux-2-klein-4b.safetensors",
      "bind": "9.unet_name"
    },
    {
      "key": "size",
      "label": "Size",
      "type": "size",
      "default": [
        1024,
        1024
      ],
      "step": 16,
      "bind": {
        "w": "7.value",
        "h": "8.value"
      }
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "default": -1,
      "bind": "12.noise_seed"
    },
    {
      "key": "steps",
      "label": "Steps",
      "type": "int",
      "default": 4,
      "min": 1,
      "max": 50,
      "advanced": true,
      "bind": "2.steps"
    },
    {
      "key": "cfg",
      "label": "CFG",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 20,
      "step": 0.1,
      "advanced": true,
      "bind": "3.cfg"
    }
  ],
  "outputs": [
    {
      "node": "15",
      "kind": "image"
    }
  ]
}
