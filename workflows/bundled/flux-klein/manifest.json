{
  "id": "flux-klein",
  "name": "Flux.2 Klein",
  "family": "flux2",
  "kind": "image",
  "category": null,
  "description": "Text-to-image with the distilled FLUX.2 [klein]: four steps at cfg 1 through the custom sampler chain, with the negative as ConditioningZeroOut, as the template ships it. The text encoder is part of the pairing rather than a detail — FLUX.2 concatenates three Qwen-3 hidden layers, so a 2560-wide encoder feeds a model expecting 7680 and a 4096-wide one feeds 12288. Pick the encoder that goes with your checkpoint or the sampler refuses the shapes.",
  "params": [
    {
      "key": "prompt",
      "label": "Prompt",
      "type": "text",
      "required": true,
      "bind": "13.text"
    },
    {
      "key": "model",
      "label": "Model",
      "type": "model",
      "filter": {
        "class": "diffusion",
        "family": "flux2"
      },
      "bind": "9.unet_name"
    },
    {
      "key": "size",
      "label": "Size",
      "type": "size",
      "default": [
        1024,
        1024
      ],
      "step": 16,
      "bind": {
        "w": "7.value",
        "h": "8.value"
      }
    },
    {
      "key": "loras",
      "label": "LoRAs",
      "type": "lora_list",
      "filter": {
        "family": "flux2"
      },
      "bind": {
        "chain": {
          "model_from": "9.MODEL",
          "clip_from": "10.CLIP",
          "model_to": [
            "3.model"
          ],
          "clip_to": [
            "13.clip"
          ]
        }
      }
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "default": -1,
      "bind": "12.noise_seed"
    },
    {
      "key": "steps",
      "label": "Steps",
      "type": "int",
      "min": 1,
      "max": 50,
      "advanced": true,
      "bind": "2.steps"
    },
    {
      "key": "cfg",
      "label": "CFG",
      "type": "float",
      "min": 0,
      "max": 20,
      "step": 0.1,
      "advanced": true,
      "bind": "3.cfg"
    },
    {
      "key": "clip",
      "label": "Text encoder (must match the model)",
      "type": "model",
      "filter": {
        "class": "clip"
      },
      "bind": "10.clip_name"
    },
    {
      "key": "vae",
      "label": "VAE",
      "type": "model",
      "filter": {
        "class": "vae"
      },
      "advanced": true,
      "bind": "11.vae_name"
    }
  ],
  "outputs": [
    {
      "node": "15",
      "kind": "image"
    }
  ]
}
