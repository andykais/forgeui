{
  "id": "sd15",
  "name": "Stable Diffusion 1.5",
  "family": "sd15",
  "kind": "image",
  "category": null,
  "description": "Text-to-image with Stable Diffusion 1.5. Small enough to run on a CPU, which is why the contract check generates with it.",
  "params": [
    {
      "key": "prompt",
      "label": "Prompt",
      "type": "text",
      "required": true,
      "bind": "6.text"
    },
    {
      "key": "negative",
      "label": "Negative prompt",
      "type": "text",
      "bind": "7.text"
    },
    {
      "key": "size",
      "label": "Size",
      "type": "size",
      "default": [
        512,
        512
      ],
      "step": 8,
      "bind": {
        "w": "5.width",
        "h": "5.height"
      }
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "default": -1,
      "bind": "3.seed"
    },
    {
      "key": "loras",
      "label": "LoRAs",
      "type": "lora_list",
      "filter": {
        "family": "sd15"
      },
      "bind": {
        "chain": {
          "model_from": "1.MODEL",
          "clip_from": "1.CLIP",
          "model_to": [
            "3.model"
          ],
          "clip_to": [
            "6.clip",
            "7.clip"
          ]
        }
      }
    },
    {
      "key": "steps",
      "label": "Steps",
      "type": "int",
      "advanced": true,
      "min": 1,
      "max": 100,
      "bind": "3.steps"
    },
    {
      "key": "cfg",
      "label": "CFG",
      "type": "float",
      "advanced": true,
      "min": 0,
      "max": 20,
      "step": 0.1,
      "bind": "3.cfg"
    }
  ],
  "outputs": [
    {
      "node": "9",
      "kind": "image"
    }
  ]
}
