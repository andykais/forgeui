{
  "id": "z-image-turbo",
  "name": "Z-Image Turbo",
  "family": "z-image",
  "kind": "image",
  "category": null,
  "description": "Few-step text-to-image with Z-Image Turbo. Eight steps at cfg 1 on res_multistep, as the official workflow ships it.",
  "params": [
    {
      "key": "prompt",
      "label": "Prompt",
      "type": "text",
      "required": true,
      "bind": "5.text"
    },
    {
      "key": "model",
      "label": "Model",
      "type": "model",
      "filter": {
        "class": "diffusion",
        "family": "z-image"
      },
      "bind": "6.unet_name"
    },
    {
      "key": "size",
      "label": "Size",
      "type": "size",
      "default": [
        1024,
        1024
      ],
      "step": 16,
      "bind": {
        "w": "4.width",
        "h": "4.height"
      }
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "default": -1,
      "bind": "1.seed"
    },
    {
      "key": "steps",
      "label": "Steps",
      "type": "int",
      "min": 1,
      "max": 50,
      "advanced": true,
      "bind": "1.steps"
    },
    {
      "key": "shift",
      "label": "Shift",
      "type": "float",
      "min": 0,
      "max": 10,
      "step": 0.1,
      "advanced": true,
      "bind": "3.shift"
    },
    {
      "key": "clip",
      "label": "Text encoder",
      "type": "model",
      "filter": {
        "class": "clip"
      },
      "advanced": true,
      "bind": "8.clip_name"
    },
    {
      "key": "vae",
      "label": "VAE",
      "type": "model",
      "filter": {
        "class": "vae"
      },
      "advanced": true,
      "bind": "7.vae_name"
    }
  ],
  "outputs": [
    {
      "node": "10",
      "kind": "image"
    }
  ]
}
