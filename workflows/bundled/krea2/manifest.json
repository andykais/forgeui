{
  "id": "krea2",
  "name": "Krea 2 Turbo",
  "family": "krea2",
  "kind": "image",
  "category": null,
  "description": "Text-to-image with Krea 2 Turbo: eight steps at cfg 1, Qwen3-VL encoding the prompt. Tick \"Enhance the prompt\" and the same encoder rewrites it into a fuller one first.",
  "params": [
    {
      "key": "prompt",
      "label": "Prompt",
      "type": "text",
      "required": true,
      "bind": "10.value"
    },
    {
      "key": "enhance",
      "label": "Enhance the prompt",
      "description": "Rewrite the prompt with the workflow's own Qwen3-VL encoder before encoding it.",
      "type": "bool",
      "default": false,
      "bind": {
        "switch": {
          "input": "4.text",
          "on": "13.STRING",
          "off": "10.STRING"
        }
      }
    },
    {
      "key": "model",
      "label": "Model",
      "type": "model",
      "filter": {
        "class": "diffusion",
        "family": "krea2"
      },
      "bind": "1.unet_name"
    },
    {
      "key": "size",
      "label": "Size",
      "type": "size",
      "default": [
        1024,
        1024
      ],
      "step": 16,
      "bind": {
        "w": "6.width",
        "h": "6.height"
      }
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "default": -1,
      "bind": "7.seed"
    },
    {
      "key": "loras",
      "label": "LoRAs",
      "type": "lora_list",
      "filter": {
        "family": "krea2"
      },
      "bind": {
        "chain": {
          "model_from": "1.MODEL",
          "clip_from": null,
          "model_to": [
            "7.model"
          ],
          "clip_to": null
        }
      }
    },
    {
      "key": "steps",
      "label": "Steps",
      "type": "int",
      "min": 1,
      "max": 50,
      "advanced": true,
      "bind": "7.steps"
    },
    {
      "key": "cfg",
      "label": "CFG",
      "type": "float",
      "min": 0,
      "max": 20,
      "step": 0.1,
      "advanced": true,
      "bind": "7.cfg"
    },
    {
      "key": "clip",
      "label": "Text encoder",
      "type": "text_encoder",
      "advanced": true,
      "bind": "2.clip_name"
    },
    {
      "key": "vae",
      "label": "VAE",
      "type": "vae",
      "advanced": true,
      "bind": "3.vae_name"
    },
    {
      "key": "max_length",
      "label": "Enhancer length",
      "type": "int",
      "min": 32,
      "max": 4096,
      "advanced": true,
      "bind": "13.max_length"
    }
  ],
  "outputs": [
    {
      "node": "9",
      "kind": "image"
    }
  ]
}
