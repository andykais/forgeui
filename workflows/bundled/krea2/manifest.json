{
  "id": "krea2",
  "name": "Krea 2 Turbo",
  "family": "krea2",
  "kind": "image",
  "category": null,
  "description": "Text-to-image with Krea 2 Turbo: eight steps at cfg 1. Enhance prompt runs the prompt through the same Qwen3-VL encoder the workflow already loads, so it costs no extra download.",
  "params": [
    {
      "key": "prompt",
      "label": "Prompt",
      "type": "text",
      "required": true,
      "default": "",
      "bind": "13.value"
    },
    {
      "key": "model",
      "label": "Model",
      "type": "model",
      "filter": {
        "class": "diffusion",
        "family": "krea2"
      },
      "default": "krea2_turbo_fp8_scaled.safetensors",
      "bind": "5.unet_name"
    },
    {
      "key": "size",
      "label": "Size",
      "type": "size",
      "default": [
        1024,
        1024
      ],
      "step": 16,
      "bind": {
        "w": "2.width",
        "h": "2.height"
      }
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "default": -1,
      "bind": "1.seed"
    },
    {
      "key": "enhance",
      "label": "Enhance prompt",
      "type": "bool",
      "default": true,
      "bind": "18.value"
    },
    {
      "key": "style",
      "label": "Darkbrush style",
      "type": "bool",
      "default": false,
      "bind": "17.value"
    },
    {
      "key": "steps",
      "label": "Steps",
      "type": "int",
      "default": 8,
      "min": 1,
      "max": 50,
      "advanced": true,
      "bind": "1.steps"
    },
    {
      "key": "cfg",
      "label": "CFG",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 20,
      "step": 0.1,
      "advanced": true,
      "bind": "1.cfg"
    }
  ],
  "outputs": [
    {
      "node": "21",
      "kind": "image"
    }
  ]
}
