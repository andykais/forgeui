{
  "id": "krea2-enhanced",
  "name": "Krea 2 Turbo (enhanced)",
  "family": "krea2",
  "kind": "image",
  "category": null,
  "description": "Krea 2 Turbo with the template's prompt enhancer: the prompt is rewritten by the same Qwen3-VL encoder the workflow already loads, then encoded. Same inputs as Krea 2 Turbo, so the two can be compared on one prompt.",
  "params": [
    {
      "key": "prompt",
      "label": "Prompt",
      "type": "text",
      "required": true,
      "default": "",
      "bind": "10.value"
    },
    {
      "key": "model",
      "label": "Model",
      "type": "model",
      "filter": {
        "class": "diffusion",
        "family": "krea2"
      },
      "default": "krea2_turbo_fp8_scaled.safetensors",
      "bind": "1.unet_name"
    },
    {
      "key": "size",
      "label": "Size",
      "type": "size",
      "default": [
        1024,
        1024
      ],
      "step": 16,
      "bind": {
        "w": "6.width",
        "h": "6.height"
      }
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "default": -1,
      "bind": "7.seed"
    },
    {
      "key": "loras",
      "label": "LoRAs",
      "type": "lora_list",
      "filter": {
        "family": "krea2"
      },
      "bind": {
        "chain": {
          "model_from": "1.MODEL",
          "clip_from": null,
          "model_to": [
            "7.model"
          ],
          "clip_to": null
        }
      }
    },
    {
      "key": "steps",
      "label": "Steps",
      "type": "int",
      "default": 8,
      "min": 1,
      "max": 50,
      "advanced": true,
      "bind": "7.steps"
    },
    {
      "key": "cfg",
      "label": "CFG",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 20,
      "step": 0.1,
      "advanced": true,
      "bind": "7.cfg"
    },
    {
      "key": "clip",
      "label": "Text encoder",
      "type": "text_encoder",
      "default": "qwen3vl_4b_fp8_scaled.safetensors",
      "advanced": true,
      "bind": "2.clip_name"
    },
    {
      "key": "vae",
      "label": "VAE",
      "type": "vae",
      "default": "qwen_image_vae.safetensors",
      "advanced": true,
      "bind": "3.vae_name"
    },
    {
      "key": "max_length",
      "label": "Enhancer length",
      "type": "int",
      "default": 512,
      "min": 32,
      "max": 4096,
      "advanced": true,
      "bind": "13.max_length"
    }
  ],
  "outputs": [
    {
      "node": "9",
      "kind": "image"
    }
  ]
}
