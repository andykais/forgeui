{
  "id": "anima",
  "name": "Anima",
  "family": "anima",
  "kind": "image",
  "category": null,
  "description": "Text-to-image with Anima Base v1. The Turbo LoRA switch is the template's own: on, it runs the turbo weights at 8 steps and cfg 1 instead of the base 30 and 4.",
  "params": [
    {
      "key": "prompt",
      "label": "Prompt",
      "type": "text",
      "required": true,
      "bind": "7.text"
    },
    {
      "key": "negative",
      "label": "Negative prompt",
      "type": "text",
      "bind": "5.text"
    },
    {
      "key": "model",
      "label": "Model",
      "type": "model",
      "filter": {
        "class": "diffusion",
        "family": "anima"
      },
      "bind": "8.unet_name"
    },
    {
      "key": "size",
      "label": "Size",
      "type": "size",
      "default": [
        1024,
        1024
      ],
      "step": 16,
      "bind": {
        "w": "4.width",
        "h": "4.height"
      }
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "default": -1,
      "bind": "6.seed"
    },
    {
      "key": "loras",
      "label": "LoRAs",
      "type": "lora_list",
      "filter": {
        "family": "anima"
      },
      "bind": {
        "chain": {
          "model_from": "12.output",
          "clip_from": "1.CLIP",
          "model_to": [
            "6.model"
          ],
          "clip_to": [
            "5.clip",
            "7.clip"
          ]
        }
      }
    },
    {
      "key": "turbo",
      "label": "Turbo LoRA",
      "type": "bool",
      "bind": "17.value"
    },
    {
      "key": "steps",
      "label": "Steps",
      "type": "int",
      "min": 1,
      "max": 100,
      "advanced": true,
      "bind": "9.value"
    },
    {
      "key": "cfg",
      "label": "CFG",
      "type": "float",
      "min": 0,
      "max": 20,
      "step": 0.1,
      "advanced": true,
      "bind": "14.value"
    },
    {
      "key": "clip",
      "label": "Text encoder",
      "type": "model",
      "filter": {
        "class": "clip"
      },
      "advanced": true,
      "bind": "1.clip_name"
    },
    {
      "key": "vae",
      "label": "VAE",
      "type": "model",
      "filter": {
        "class": "vae"
      },
      "advanced": true,
      "bind": "2.vae_name"
    }
  ],
  "outputs": [
    {
      "node": "18",
      "kind": "image"
    }
  ]
}
