{
  "id": "anima",
  "name": "Anima",
  "family": "anima",
  "kind": "image",
  "category": null,
  "description": "Text-to-image with Anima Base v1. The Turbo LoRA switch is the template's own: on, it runs the turbo weights at 8 steps and cfg 1 instead of the base 30 and 4.",
  "params": [
    {
      "key": "prompt",
      "label": "Prompt",
      "type": "text",
      "required": true,
      "default": "",
      "bind": "7.text"
    },
    {
      "key": "negative",
      "label": "Negative prompt",
      "type": "text",
      "default": "worst quality, low quality, score_1, score_2, score_3, blurry, jpeg artifacts, sepia",
      "bind": "5.text"
    },
    {
      "key": "model",
      "label": "Model",
      "type": "model",
      "filter": {
        "class": "diffusion",
        "family": "anima"
      },
      "default": "anima-base-v1.0.safetensors",
      "bind": "8.unet_name"
    },
    {
      "key": "size",
      "label": "Size",
      "type": "size",
      "default": [
        1024,
        1024
      ],
      "step": 16,
      "bind": {
        "w": "4.width",
        "h": "4.height"
      }
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "default": -1,
      "bind": "6.seed"
    },
    {
      "key": "turbo",
      "label": "Turbo LoRA",
      "type": "bool",
      "default": false,
      "bind": "17.value"
    },
    {
      "key": "steps",
      "label": "Steps",
      "type": "int",
      "default": 30,
      "min": 1,
      "max": 100,
      "advanced": true,
      "bind": "9.value"
    },
    {
      "key": "cfg",
      "label": "CFG",
      "type": "float",
      "default": 4,
      "min": 0,
      "max": 20,
      "step": 0.1,
      "advanced": true,
      "bind": "14.value"
    }
  ],
  "outputs": [
    {
      "node": "18",
      "kind": "image"
    }
  ]
}
